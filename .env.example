# Copiar a .env.local y rellenar. Los tres primeros son obligatorios.
#
# Generar CLAVE_ACCESO y SECRETO_COOKIE:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Key de console.anthropic.com, emitida DENTRO de un workspace con limite de
# gasto mensual. Ese limite es el unico corte duro de coste que existe.
ANTHROPIC_API_KEY=

# Token del link magico: https://<dominio>/?k=<CLAVE_ACCESO>
CLAVE_ACCESO=

# Clave HMAC de la cookie de sesion. Rotarla cierra todas las sesiones abiertas.
SECRETO_COOKIE=

# Opcional. Clave del conector MCP para ChatGPT/Claude: https://<dominio>/api/mcp?k=<esta>
# Sin ella, /api/mcp responde 401. Distinta de CLAVE_ACCESO a proposito.
CLAVE_MCP=
