{
  "name": "chatbot-mama",
  "version": "2.0.0",
  "private": true,
  "description": "Asistente que responde solo con lo que los medicos autorizaron",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "generar": "tsx scripts/generar-conocimiento.ts",
    "predev": "pnpm generar",
    "dev": "next dev",
    "prebuild": "pnpm generar",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tipos": "tsc --noEmit",
    "probar:local": "tsx pruebas/local/index.ts",
    "probar:api": "node --env-file-if-exists=.env.local --import tsx pruebas/api/index.ts",
    "probar:golden": "node --env-file-if-exists=.env.local --import tsx pruebas/golden/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@gsap/react": "^2.1.2",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
